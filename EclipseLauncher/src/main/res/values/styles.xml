<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="EclipseShapeAppearance" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">@dimen/_12sdp</item>
    </style>

    <!-- Medium components (cards, list surfaces) get a softer corner than the
         small controls so the hierarchy reads as designed rather than uniform. -->
    <style name="EclipseShapeMedium" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">@dimen/_16sdp</item>
    </style>

    <!-- Large components (dialogs, bottom sheets) use a pillowy corner. -->
    <style name="EclipseShapeLarge" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">@dimen/_28sdp</item>
    </style>

    <style name="AppTheme" parent="@style/Theme.Material3.DayNight.NoActionBar">
        <item name="windowNoTitle">true</item>
        <item name="windowActionBar">false</item>
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:statusBarColor">@color/background_status_bar</item>
        <item name="android:navigationBarColor">?attr/colorSurface</item>
        <item name="android:scrollbarThumbHorizontal">?attr/colorOutline</item>
        <item name="android:scrollbarThumbVertical">?attr/colorOutline</item>
        <item name="android:textSize">@dimen/_12ssp</item>
        <item name="shapeAppearanceSmallComponent">@style/EclipseShapeAppearance</item>
        <item name="shapeAppearanceMediumComponent">@style/EclipseShapeMedium</item>
        <item name="shapeAppearanceLargeComponent">@style/EclipseShapeLarge</item>
    </style>

    <style name="CustomDialogStyle" parent="Theme.Material3.DayNight.Dialog">
        <item name="android:windowBackground">@drawable/dialog_background</item>
        <item name="android:scrollbarThumbHorizontal">?attr/colorOutline</item>
        <item name="android:scrollbarThumbVertical">?attr/colorOutline</item>
    </style>

    <style name="CustomAlertDialogTheme" parent="Theme.Material3.DayNight.Dialog.Alert">
        <item name="android:windowBackground">@drawable/dialog_background</item>
        <item name="android:scrollbarThumbHorizontal">?attr/colorOutline</item>
        <item name="android:scrollbarThumbVertical">?attr/colorOutline</item>
    </style>

    <style name="RoundedCornersImageView">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">4%</item>
    </style>

    <style name="RoundImageView">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">50%</item>
    </style>
</resources>
