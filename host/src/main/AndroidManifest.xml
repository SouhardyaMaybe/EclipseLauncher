<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
      The game and installer live in their own processes. Both are visible
      activities rather than services: the screen is the reason the process is
      alive, and leaving the screen checkpoints the work instead of pretending
      a background service will finish it. See docs/11 §4.
    -->
    <application>
        <activity
            android:name=".GameActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|uiMode|density"
            android:exported="false"
            android:process=":game"
            android:resizeableActivity="true"
            android:theme="@android:style/Theme.Material.NoActionBar" />

        <activity
            android:name=".InstallerActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|uiMode|density"
            android:exported="false"
            android:process=":installer"
            android:theme="@android:style/Theme.Material.NoActionBar" />
    </application>

</manifest>
