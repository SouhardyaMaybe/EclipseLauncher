<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme for dark mode - minimal theme -->
    <style name="Theme.EclipseLauncher" parent="android:Theme">
        <!-- Primary brand color -->
        <item name="android:colorPrimary">@color/primary</item>
        <item name="android:colorOnPrimary">@color/onPrimary</item>
        <!-- Secondary brand color -->
        <item name="android:colorSecondary">@color/secondary</item>
        <item name="android:colorOnSecondary">@color/onSecondary</item>
        <!-- Status bar color -->
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <!-- Window flags -->
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowActionBar">false</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
    </style>
</resources>